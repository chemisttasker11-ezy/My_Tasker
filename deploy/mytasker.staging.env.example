# Copy to ignored env/mytasker.staging.env on the OVH server (chmod 600).
# These are placeholders, never paste real credentials into GitHub.
MYTASKER_HOST=YOUR_STAGING_HOSTNAME
MYTASKER_DB_PASSWORD=GENERATE_STAGING_ONLY_DB_PASSWORD
SECRET_KEY=GENERATE_STAGING_ONLY_DJANGO_KEY
ADMIN_TOTP_ENCRYPTION_KEY=GENERATE_STAGING_ONLY_FERNET_KEY
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=STAGING_VERIFIED_SMTP_USERNAME
EMAIL_HOST_PASSWORD=STAGING_SMTP_APP_PASSWORD
DEFAULT_FROM_EMAIL=REPLACE_WITH_VERIFIED_FROM_ADDRESS
VITE_RECAPTCHA_SITE_KEY=REPLACE_WITH_AUTHORISED_DOMAIN_SITE_KEY
RECAPTCHA_SECRET_KEY=STAGING_DOMAIN_RECAPTCHA_SECRET
# Only the actual CIDR of the OVH shared Nginx reverse-proxy network.
TRUSTED_PROXY_CIDRS=
