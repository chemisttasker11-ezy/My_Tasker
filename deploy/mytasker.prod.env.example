# Copy to ignored env/mytasker.prod.env on the OVH server (chmod 600).
# These are placeholders, never paste real credentials into GitHub.
MYTASKER_HOST=YOUR_TESTED_PUBLIC_HOSTNAME
MYTASKER_DB_PASSWORD=REPLACE_WITH_NEW_UNIQUE_DB_PASSWORD
SECRET_KEY=REPLACE_WITH_NEW_DJANGO_SECRET_KEY_MIN_40_CHARS
ADMIN_TOTP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_GENERATE_KEY_OUTPUT
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_WITH_VERIFIED_SMTP_USERNAME
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
DEFAULT_FROM_EMAIL=REPLACE_WITH_VERIFIED_FROM_ADDRESS
VITE_RECAPTCHA_SITE_KEY=REPLACE_WITH_AUTHORISED_DOMAIN_SITE_KEY
RECAPTCHA_SECRET_KEY=REPLACE_WITH_MATCHING_PRIVATE_SECRET
# Only the actual CIDR of the OVH shared Nginx reverse-proxy network.
TRUSTED_PROXY_CIDRS=
